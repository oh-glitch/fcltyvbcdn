# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real API keys.

NEXT_PUBLIC_APP_NAME=Facility AI Assistant

# --- OpenAI (required for chat + RAG embeddings) ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
# Embeddings model (default: text-embedding-3-small, 1536 dimensions)
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ENABLE_DEMO_CHAT=true

# --- Supabase (required for PDF uploads) ---
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Future steps (not used yet) ---
CLERK_PUBLISHABLE_KEY=
